# ============================================================
# F0.5/F1.0 Backend 本地配置模板（脱敏，可提交 Git）
# 真实配置在 .env（仅本机，禁止提交）
# 复制本文件为 .env 后填写真实值
# ============================================================

# ---- PostgreSQL（growth_workspace_reader 只读角色）----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=growth_workspace_reader
DB_PASSWORD=[REDACTED]

# ---- 管理凭据（仅本机运维用，脚本从 mcp_server/.env 读取 PG_ADMIN_PASSWORD）----
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=[REDACTED]

# ---- 查询超时 ----
STATEMENT_TIMEOUT_MS=10000

# ---- 会话 / 安全 ----
SESSION_SECRET=[REDACTED]

# ---- 飞书网页应用（接入清单见 docs/F1.0_飞书网页应用接入清单.md）----
# App ID / App Secret 来自飞书开放平台创建的企业自建应用
FEISHU_APP_ID=[FEISHU_APP_ID]
FEISHU_APP_SECRET=[FEISHU_APP_SECRET]

# ---- 服务绑定（局域网分享时改为 0.0.0.0）----
HOST=127.0.0.1
PORT=8001
